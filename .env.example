# OBP API (write target — dynamic entities)
OBP_URL=https://dcr.ogcr.tesobe.com
OBP_USERNAME=your_username
OBP_PASSWORD=your_password
OBP_CONSUMER_KEY=your_consumer_key

# Ethereum (read source — OGCR chain 2025). Read-only: no private key needed.
RPC_URL=https://nkotb.openbankproject.com
# The three NFT contracts this tool mirrors (from the tokenizer deployment).
PARCEL_CONTRACT_ADDRESS=0x62227531b82259561CC9ad4413188F08E536598a
ACTIVITY_CONTRACT_ADDRESS=0x5034F49b27353CeDc562b49eA91C7438Ea351d36
CERTIFICATION_CONTRACT_ADDRESS=0x2e335F247E91caa168c64b63104C4475b2af3942

# Optional: block to start scanning *Minted events from (default 0)
FROM_BLOCK=0
