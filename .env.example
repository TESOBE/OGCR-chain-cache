# OBP API (write target — dynamic entities)
OBP_URL=https://dcr.ogcr.tesobe.com
# This tool calls OBP as a Platform App (OAuth2 client credentials from
# OBP-OIDC), not as a User. OIDC_ISSUER is the OBP-OIDC issuer, e.g.
# http://localhost:9000/obp-oidc locally; the client id and secret are the OIDC
# client created for this app. See "Authentication" in the README.
OIDC_ISSUER=your_oidc_issuer
OIDC_CLIENT_ID=your_client_id
OIDC_CLIENT_SECRET=your_client_secret
# The bank (aka Space) the *_on_chain entities live in. Same variable as
# OGCR-DynamicEntities and OGCR-App; keep all three on the same value. Defaults
# to ogcr; set it to the empty string for system level entities.
OBP_ENTITY_SPACE_ID=ogcr
# The cacher creates missing entities and updates changed ones on start, like a
# migration. Set to false where an administrator manages the definitions.
#AUTO_SETUP_ENTITIES=true

# Ethereum (read source — OGCR chain 20253). Read-only: no private key needed.
RPC_URL=https://nkotb.openbankproject.com
# The NFT contracts this tool mirrors, from
# OGCR-Smart-Contracts/deployments/token-system-20253.env (deployed at block 3837).
PARCEL_CONTRACT_ADDRESS=0x2ba7fF2e19483f01Ce8599e6dab230B3d660Ecad
ACTIVITY_CONTRACT_ADDRESS=0x44fEe614D36E1deA164f9407abD7d6264eFf5c12
CERTIFICATION_CONTRACT_ADDRESS=0x1Bf2e9DC09eD2A26c53e0f863794662766888Db5

# The carbon-credit half of the token family. Optional: leave either unset and
# the cacher skips that mirror instead of failing, so it still runs against a
# chain where the credit contracts are not deployed yet.
CREDIT_BATCH_CONTRACT_ADDRESS=0x7248f0BEFc1C1774cCfa4Dd847A667418e4037c0
CREDIT_CONTRACT_ADDRESS=0xB873ce0d948c34E195DE42CdEE6B2e652Ab423C4

# Optional: block to start scanning *Minted events from (default 0). The 20253
# contracts were deployed at block 3837, so nothing earlier needs scanning.
FROM_BLOCK=3837
