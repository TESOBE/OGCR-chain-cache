# OBP API (write target — dynamic entities)
OBP_URL=https://dcr.ogcr.tesobe.com
OBP_USERNAME=your_username
OBP_PASSWORD=your_password
OBP_CONSUMER_KEY=your_consumer_key

# Ethereum (read source — OGCR chain 2025)
RPC_URL=https://nkotb.openbankproject.com
# CarbonProjectNFT — the contract the tokenizer mints into.
# Deployment doc lists 0xeec918d74c746167564401103096D45BbD494B74;
# tokenizer/.env.example uses 0x30753E4A8aad7F8597332E813735Def5dD395028.
# Confirm which is live before running.
CONTRACT_ADDRESS=0xeec918d74c746167564401103096D45BbD494B74

# Optional: block to start scanning CarbonProjectMinted events from (default 0)
FROM_BLOCK=0
